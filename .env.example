# ======================================
# Node Environment
# ======================================
NODE_ENV=development

# ======================================
# Server Configuration
# ======================================
PORT=3000

# ======================================
# Database Configuration (PostgreSQL)
# ======================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=dataharvest_user
DB_PASSWORD=dataharvest_pass
DB_NAME=dataharvest
DB_SSL=false
DB_DEBUG=false

# ======================================
# Redis Configuration (for BullMQ)
# ======================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ======================================
# Queue Worker Concurrency
# ======================================
SCRAPER_CONCURRENCY=3

TRANSFORMER_CONCURRENCY=5

PERSISTER_CONCURRENCY=2

# ======================================
# Rate Limiting
# ======================================
MIN_REQUEST_DELAY_MS=1000

# ======================================
# Scheduler Configuration (Cron)
# ======================================
# Enable/disable automatic scheduled scraping
ENABLE_SCHEDULER=false

# Books scraping schedule (daily at 02:00 UTC)
# Format: "minute hour day month weekday"
BOOKS_CRON=0 2 * * *

# Hacker News scraping schedule (every 15 minutes)
HN_CRON=*/15 * * * *

# ======================================
# Scraper Configuration
# ======================================
BOOKS_MAX_PAGES=5
HN_MAX_PAGES=2

# User agent for web scraping
USER_AGENT=DataHarvestBot/1.0 (tech-assessment)

# ======================================
# Logging
# ======================================
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ======================================
# Graceful Shutdown
# ======================================
SHUTDOWN_TIMEOUT_MS=30000

# ======================================
# Bull Board Dashboard (Optional)
# ======================================
BULL_BOARD_ENABLED=true

# Path where the dashboard will be accessible
BULL_BOARD_PATH=/admin/queues

# Dashboard authentication credentials
# IMPORTANT: Change these in production!
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=change_me_in_production_please
