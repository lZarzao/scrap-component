# ======================================
# Node Environment
# ======================================
NODE_ENV=development

# ======================================
# Server Configuration
# ======================================
PORT=3000

# ======================================
# Database Configuration (PostgreSQL)
# ======================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=dataharvest_user
DB_PASSWORD=dataharvest_pass
DB_NAME=dataharvest
DB_SSL=false
DB_DEBUG=false

# ======================================
# Redis Configuration (for BullMQ)
# ======================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ======================================
# Queue Worker Concurrency
# ======================================
# Number of concurrent scraper workers
SCRAPER_CONCURRENCY=3

# Number of concurrent transformer workers
TRANSFORMER_CONCURRENCY=5

# Number of concurrent persister workers
PERSISTER_CONCURRENCY=2

# ======================================
# Rate Limiting
# ======================================
# Minimum delay between HTTP requests (milliseconds)
MIN_REQUEST_DELAY_MS=1000

# ======================================
# Scheduler Configuration (Cron)
# ======================================
# Enable/disable scheduler (true/false)
ENABLE_SCHEDULER=true

# Books scraping schedule (daily at 02:00 UTC)
# Format: "minute hour day month weekday"
BOOKS_CRON=0 2 * * *

# Hacker News scraping schedule (every 15 minutes)
HN_CRON=*/15 * * * *

# ======================================
# Scraper Configuration
# ======================================
# Number of pages to scrape for books (1-10)
BOOKS_MAX_PAGES=5

# Number of pages to scrape for Hacker News (1-5)
HN_MAX_PAGES=2

# User agent for web scraping
USER_AGENT=DataHarvestBot/1.0 (tech-assessment)

# ======================================
# Logging
# ======================================
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ======================================
# Graceful Shutdown
# ======================================
# Maximum time to wait for in-flight jobs during shutdown (milliseconds)
SHUTDOWN_TIMEOUT_MS=30000
